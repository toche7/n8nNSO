{
  "name": "M3W1_Daily Weather Email Report",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 7
            }
          ]
        }
      },
      "id": "adeea886-b99a-4199-a3b2-0f4836d41a20",
      "name": "Every Day at 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        544,
        -48
      ]
    },
    {
      "parameters": {
        "url": "https://api.open-meteo.com/v1/forecast",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "latitude",
              "value": "13.75"
            },
            {
              "name": "longitude",
              "value": "100.52"
            },
            {
              "name": "daily",
              "value": "temperature_2m_max,temperature_2m_min"
            },
            {
              "name": "timezone",
              "value": "Asia/Bangkok"
            }
          ]
        },
        "options": {}
      },
      "id": "c63f5948-dce2-47f2-8d8d-ffb8a093b5c6",
      "name": "Fetch Weather Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        736,
        -48
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "date",
              "value": "={{ $json.daily.time[0] }}",
              "type": "string"
            },
            {
              "id": "2",
              "name": "maxTemp",
              "value": "={{ $json.daily.temperature_2m_max[0] }}",
              "type": "number"
            },
            {
              "id": "3",
              "name": "minTemp",
              "value": "={{ $json.daily.temperature_2m_min[0] }}",
              "type": "number"
            },
            {
              "id": "4",
              "name": "avgTemp",
              "value": "={{ ($json.daily.temperature_2m_max[0] + $json.daily.temperature_2m_min[0]) / 2 }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "bdb63337-5b65-46dc-a06b-35331d52407e",
      "name": "Calculate Average Temperature",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        944,
        -48
      ]
    },
    {
      "parameters": {
        "sendTo": "recipients@email.com",
        "subject": "Weather Report",
        "emailType": "text",
        "message": "=ข้อมูลวันที่ {{ $json.date }}\nอุณหภูมิสูงสุด: {{ $json.maxTemp }}\nอุณหภูมิต่ำสุด: {{ $json.minTemp }}\nอุณหภูมิเฉลี่ย: {{ $json.avgTemp }}",
        "options": {}
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1168,
        -48
      ],
      "id": "9a52e971-2fd4-402d-9985-391f080f9480",
      "name": "Send a message",
      "webhookId": "67e58520-5e7b-4a14-8131-bdcb603c3459",
      "credentials": {
        "gmailOAuth2": {
          "id": "JAKTdugGVKAKG5W2",
          "name": "Gmail akesamachuen@gmail.com"
        }
      }
    }
  ],
  "pinData": {},
  "connections": {
    "Every Day at 07:00": {
      "main": [
        [
          {
            "node": "Fetch Weather Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Weather Data": {
      "main": [
        [
          {
            "node": "Calculate Average Temperature",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Calculate Average Temperature": {
      "main": [
        [
          {
            "node": "Send a message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate"
  },
